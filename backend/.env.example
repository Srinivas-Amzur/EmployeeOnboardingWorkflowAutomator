# Environment variables for Backend

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?ssl=require
DB_SSL_REQUIRE=true
DB_CONNECT_TIMEOUT=15
DB_COMMAND_TIMEOUT=30
DB_SOCKET_TIMEOUT=5
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=45
DB_POOL_RECYCLE=600

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production-12345
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# LiteLLM Configuration
LITELLM_PROXY_URL=https://litellm.amzur.com
LITELLM_API_KEY=your-litellm-api-key

# ChromaDB Configuration
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# SMTP Configuration (Optional - for email notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@onboarding.com
